# Configuración de cobertura para módulos SWAL 2 (redes de seguridad + ciclo de
# vida + correlación). Mide cobertura de DECISIONES (branch).
#
# El scope se fija aquí con [report] include (whitelist explícita de los 9 archivos
# SWAL 2), independiente de la plataforma: el gate fail_under se computa SOLO sobre
# esos archivos aunque la medición sea más amplia (en Linux --cov=<ruta> puede medir
# de más). Comando: ver 09_SVP.md §4.4 y .github/workflows/ci.yml.
[run]
branch = True

omit =
    */tests/*
    */__pycache__/*

[report]
precision = 1
show_missing = True
# Objetivo SWAL 2 (propuesto, a acordar con ANAC): cobertura de decisiones >= 80 %.
fail_under = 80
# Scope explícito: solo las unidades de seguridad definen el número y el gate.
include =
    */player/tracking/lifecycle.py
    */player/areas/apw.py
    */player/areas/model.py
    */player/areas/store.py
    */player/msaw/engine.py
    */player/msaw/model.py
    */player/msaw/data.py
    */analysis/stca_analyzer.py
    */fusion/correlator.py
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
